<pre><code>import sys
import boto3
from botocore.exceptions import ClientError

CHECKS = [
    ("Bronze bucket", "sgae-data-lake-prod-bronze"),
    ("Silver bucket", "sgae-data-lake-prod-silver"),
    ("Gold bucket", "sgae-data-lake-prod-gold"),
    ("Sandbox bucket", "sgae-data-lake-prod-sandbox"),
]


def check_bucket(s3, name: str) -> bool:
    try:
        s3.head_bucket(Bucket=name)
        return True
    except ClientError:
        return False


def main() -> int:
    s3 = boto3.client("s3")
    failures = 0
    for label, bucket in CHECKS:
        ok = check_bucket(s3, bucket)
        print(f"[{'OK' if ok else 'FAIL'}] {label}: {bucket}")
        if not ok:
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())</code></pre>
