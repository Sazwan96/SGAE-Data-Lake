      <div class="file-body">
<pre><code>from pyspark.sql import SparkSession
import pandas as pd
import numpy as np
from sklearn.ensemble import IsolationForest

spark = SparkSession.builder.appName("royalty_anomaly").getOrCreate()
df = spark.read.parquet("s3://sgae-data-lake-prod/gold/royalty_member_monthly/")
pdf = df.toPandas()

pdf = pdf.sort_values(["member_id", "month"])
pdf["rolling_mean"] = pdf.groupby("member_id")["total_net"].transform(
    lambda s: s.rolling(3, min_periods=1).mean())
pdf["rolling_std"] = pdf.groupby("member_id")["total_net"].transform(
    lambda s: s.rolling(3, min_periods=1).std())
pdf["zscore"] = (pdf["total_net"] - pdf["rolling_mean"]) / pdf["rolling_std"].replace(0, np.nan)
pdf["zscore_flag"] = pdf["zscore"].abs() &gt; 3

features = pdf[["total_net", "total_works"]].fillna(0).values
iso = IsolationForest(contamination=0.02, random_state=42)
pdf["iso_flag"] = iso.fit_predict(features) == -1

anomalies = pdf[pdf["iso_flag"] | pdf["zscore_flag"]]
result = spark.createDataFrame(anomalies[["month", "member_id", "total_net", "zscore", "iso_flag", "zscore_flag"]])
result.write.mode("overwrite").parquet("s3://sgae-data-lake-prod/gold/royalty_anomaly/")</code></pre>
