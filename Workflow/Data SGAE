<pre><code>-- Kadar lulus DQ mengikut domain (30 hari)
WITH dq_results AS (
    SELECT domain, rule_name, severity, check_date,
        total_records, failed_records,
        CASE WHEN total_records = 0 THEN 1.0
             ELSE 1.0 - (failed_records::float / total_records) END AS pass_rate
    FROM governance.dq_results
    WHERE check_date &gt;= CURRENT_DATE - INTERVAL '30 days'
)
SELECT domain, AVG(pass_rate) AS avg_pass_rate,
       SUM(failed_records) AS total_failed,
       COUNT(DISTINCT rule_name) AS rules_count
FROM dq_results
WHERE severity = 'critical'
GROUP BY domain
ORDER BY avg_pass_rate ASC;</code></pre>
