function downloadBlob(content, filename, mime) {
  const blob = new Blob([content], { type: mime + ';charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function exportDoc(format) {
  let content, mime, filename;
  if (format === 'md') {
    content = generateMarkdown();
    mime = 'text/markdown';
    filename = 'sgae-datalake.md';
  } else if (format === 'json') {
    content = JSON.stringify(generateJSON(), null, 2);
    mime = 'application/json';
    filename = 'sgae-datalake.json';
  } else if (format === 'csv') {
    content = generateCSV();
    mime = 'text/csv';
    filename = 'sgae-datalake.csv';
  } else {
    content = generateText();
    mime = 'text/plain';
    filename = 'sgae-datalake.txt';
  }
  downloadBlob(content, filename, mime);
}

function generateMarkdown() {
  let md = '# SGAE Data Lake - Dokumentasi\n\n';
  sections.forEach(sec => {
    const h2 = sec.querySelector('h2');
    if (!h2) return;
    md += `\n## ${h2.textContent.replace(/^\d+\s*/, '')}\n\n`;
    sec.querySelectorAll('p, li, h3').forEach(el => {
      if (el.tagName === 'H3') md += `### ${el.textContent}\n\n`;
      else if (el.tagName === 'P') md += `${el.textContent}\n\n`;
      else md += `- ${el.textContent}\n`;
    });
  });
  return md;
}

function generateJSON() {
  return {
    title: 'SGAE Data Lake',
    version: '4.0',
    generated: new Date().toISOString(),
    sections: Array.from(sections).map(s => ({ id: s.id, category: s.dataset.cat, title: s.querySelector('h2')?.textContent || '' })),
    files: { total: 65, inZip: 30 },
    kpi: { freshness: '> 99%', dq: '100%', availability: '99.5%', rto: '4h', rpo: '1h' }
  };
}

function generateCSV() {
  let csv = 'Section,Category,Title\n';
  sections.forEach(s => csv += `"${s.id}","${s.dataset.cat}","${s.querySelector('h2')?.textContent.replace(/"/g, '""') || ''}"\n`);
  return csv;
}

function generateText() {
  let txt = 'SGAE DATA LAKE - DOKUMENTASI\n' + '='.repeat(50) + '\n\n';
  sections.forEach(s => {
    const h2 = s.querySelector('h2');
    if (h2) txt += `\n${h2.textContent}\n${'-'.repeat(40)}\n${s.textContent.replace(h2.textContent, '').trim().slice(0, 500)}\n\n`;
  });
  return txt;
}

