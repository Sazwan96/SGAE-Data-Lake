      content = JSON.stringify(generateJSON(), null, 2);
      mime = 'application/json';
      filename += '.json';
    } else if (format === 'csv') {
      content = generateCSV();
      mime = 'text/csv';
      filename += '.csv';
    } else {
      content = generateText();
      mime = 'text/plain';
      filename += '.txt';
