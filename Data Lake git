function countFiles() {
  const files = Object.keys(PROJECT_FILES);
  const folders = new Set();
  files.forEach(f => {
    const parts = f.split('/');
    for (let i = 1; i < parts.length; i++) folders.add(parts.slice(0, i).join('/'));
  });
  return { files: files.length, folders: folders.size };
}

function updateZipPreview() {
  const files = Object.keys(PROJECT_FILES).sort();
  const stats = countFiles();
  document.getElementById('zip-file-count').textContent = stats.files;
  document.getElementById('zip-folder-count').textContent = stats.folders;
  let size = 0;
  files.forEach(f => size += PROJECT_FILES[f].length);
  document.getElementById('zip-size').textContent = (size / 1024).toFixed(1) + ' KB';
  document.getElementById('zip-preview').textContent = 'sgae-data-lake/\n' + files.map(f => '├── ' + f).join('\n');
}

async function exportZIP() {
  if (typeof JSZip === 'undefined') {
    alert('JSZip belum dimuatkan. Semak sambungan internet anda.');
    return;
  }
  const btn = event.target;
  const originalText = btn.innerHTML;
  btn.innerHTML = '⏳ Menjana ZIP...';
  btn.disabled = true;
  try {
    const zip = new JSZip();
    Object.entries(PROJECT_FILES).forEach(([path, content]) => {
      zip.file(path, content);
    });
    const blob = await zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `sgae-data-lake-${new Date().toISOString().slice(0, 10)}.zip`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    btn.innerHTML = '✅ ZIP Dimuat Turun!';
    setTimeout(() => { btn.innerHTML = originalText; btn.disabled = false; }, 2000);
  } catch (err) {
    alert('Gagal: ' + err.message);
    btn.innerHTML = originalText;
    btn.disabled = false;
  }
}

