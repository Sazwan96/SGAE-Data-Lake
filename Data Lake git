function swapDiff() {
  const a = document.getElementById('diff-a');
  const b = document.getElementById('diff-b');
  const tmp = a.value;
  a.value = b.value;
  b.value = tmp;
}

function clearDiff() {
  document.getElementById('diff-a').value = '';
  document.getElementById('diff-b').value = '';
  document.getElementById('diff-output').style.display = 'none';
}

function escapeHtml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function computeDiff() {
  const a = document.getElementById('diff-a').value;
  const b = document.getElementById('diff-b').value;

  if (!a && !b) {
    alert('Masukkan teks dalam sekurang-kurangnya satu kotak.');
    return;
  }

  if (typeof Diff === 'undefined') {
    alert('Diff library belum dimuatkan.');
    return;
  }

  const result = Diff.diffLines(a, b);
  let added = 0, removed = 0, unchanged = 0;
  let html = '';
  let lineA = 1, lineB = 1;

  result.forEach(part => {
    const lines = part.value.split('\n');
    if (lines[lines.length - 1] === '') lines.pop();

    lines.forEach(line => {
      let cls, lineNum;
      if (part.added) {
        cls = 'added'; lineNum = lineB++;
        added++;
      } else if (part.removed) {
        cls = 'removed'; lineNum = lineA++;
        removed++;
      } else {
        cls = 'unchanged'; lineNum = lineA++;
        lineB++;
        unchanged++;
      }
      const prefix = part.added ? '+' : part.removed ? '-' : ' ';
      html += `<div class="diff-line ${cls}"><span class="ln">${lineNum}</span><span>${prefix} ${escapeHtml(line)}</span></div>`;
    });
  });

  document.getElementById('stat-added').textContent = '+' + added;
  document.getElementById('stat-removed').textContent = '-' + removed;
  document.getElementById('stat-unchanged').textContent = '=' + unchanged;
  document.getElementById('diff-content').innerHTML = html || '<div style="padding:1rem;color:var(--muted);">Tiada perbezaan.</div>';
  document.getElementById('diff-output').style.display = 'block';
}

