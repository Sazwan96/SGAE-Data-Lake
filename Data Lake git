      }).addTo(map).bindPopup(
        `<strong>${loc.name}</strong><br><em>${loc.type}</em><br>${loc.desc}`
      );
    });
  }

  // ===== TIMELINE =====
  document.querySelectorAll('.timeline-item').forEach(item => {
    item.addEventListener('click', () => {
      const detail = document.getElementById('timeline-detail');
      const phase = item.dataset.phase;
      const statusColor = item.dataset.status === 'Selesai' ? 'var(--success)' :
                          item.dataset.status === 'Dalam Proses' ? 'var(--warning)' : 'var(--muted)';
      detail.innerHTML = `
        <h4>${item.dataset.title}</h4>
        <p>${item.dataset.desc}</p>
        <p style="margin-top: 0.5rem;">
          <span style="color: ${statusColor}; font-weight: 600;">● ${item.dataset.status}</span>
        </p>
      `;
