  });

  // ===== LIVE STATUS =====
  const statusConfigs = [
    { id: 'pipeline', label: 'Pipelines', format: v => `${v} aktif`, meta: v => `Berjaya hari ini: ${v}` },
    { id: 'dq', label: 'DQ', format: v => `${v}%`, meta: v => v >= 100 ? 'Semua lulus' : 'Ada kegagalan' },
    { id: 'freshness', label: 'Fresh', format: v => `${v}j`, meta: v => v <= 24 ? 'Dalam SLA' : 'Lewat SLA' },
    { id: 'query', label: 'Query', format: v => `${v}`, meta: v => 'Sesi aktif' },
    { id: 'storage', label: 'Storan', format: v => `${v} TB`, meta: v => 'Dari 50 TB kapasiti' },
    { id: 'cost', label: 'Kos', format: v => `€${v}`, meta: v => 'Setakat hari ini' }
  ];
  function updateStatus() {
    statusConfigs.forEach(cfg => {
      const card = document.querySelector(`[data-comp="${cfg.id}"]`);
      const valEl = document.getElementById(`val-${cfg.id}`);
      const metaEl = document.getElementById(`meta-${cfg.id}`);
      let value, isWarn = false, isErr = false;
      if (cfg.id === 'pipeline') value = 12 + Math.floor(Math.random() * 5);
      else if (cfg.id === 'dq') { value = 98 + Math.floor(Math.random() * 3); isWarn = value < 100; }
      else if (cfg.id === 'freshness') { value = 12 + Math.floor(Math.random() * 15); isWarn = value > 24; }
      else if (cfg.id === 'query') value = 3 + Math.floor(Math.random() * 8);
      else if (cfg.id === 'storage') value = (28 + Math.random() * 5).toFixed(1);
      else if (cfg.id === 'cost') { value = (300 + Math.random() * 150).toFixed(0); isWarn = value > 400; }
      if (valEl) valEl.textContent = cfg.format(value);
      if (metaEl) metaEl.textContent = cfg.meta(value);
      if (card) {
        card.classList.toggle('warn', isWarn);
        card.classList.toggle('err', isErr);
      }
