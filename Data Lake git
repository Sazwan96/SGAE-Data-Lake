      { name: 'AWS eu-west-1 (Ireland)', lat: 53.3498, lng: -6.2603, type: 'Pusat Data', color: '#10b981', desc: 'Prod data lake' },
      { name: 'AWS eu-central-1 (Frankfurt)', lat: 50.1109, lng: 8.6821, type: 'DR', color: '#ef4444', desc: 'DR failover' }
