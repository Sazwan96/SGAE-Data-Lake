<script>
  // ===== Theme =====
  const htmlEl = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle');
  const savedTheme = localStorage.getItem('sgae-theme') || 'light';
  htmlEl.setAttribute('data-theme', savedTheme);
  updateThemeButton();
  themeToggle.addEventListener('click', () => {
    const next = htmlEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    htmlEl.setAttribute('data-theme', next);
    localStorage.setItem('sgae-theme', next);
    updateThemeButton();
    document.querySelectorAll('.mermaid').forEach(el => {
      const orig = el.getAttribute('data-original');
      if (orig) el.innerHTML = orig;
    });
    mermaid.init(undefined, '.mermaid');
    updateChartTheme();
  });
  function updateThemeButton() {
    themeToggle.textContent = htmlEl.getAttribute('data-theme') === 'dark' ? '☀️ Tema Cerah' : '🌙 Tema Gelap';
  }

  // ===== Print =====
  document.getElementById('print-btn').addEventListener('click', () => window.print());

  // ===== Mermaid =====
  document.querySelectorAll('.mermaid').forEach(el => el.setAttribute('data-original', el.innerHTML));
  mermaid.initialize({ startOnLoad: true, theme: 'default', flowchart: { useMaxWidth: true, htmlLabels: true }, sequence: { useMaxWidth: true }, gantt: { useMaxWidth: true } });

  // ===== File toggle =====
  function toggleFile(header) {
    const file = header.parentElement;
    file.classList.toggle('collapsed');
    header.querySelector('span:last-child').textContent = file.classList.contains('collapsed') ? '▶' : '▼';
  }

  // ===== Sidebar =====
  const sidebar = document.getElementById('sidebar');
  const toggleBtn = document.getElementById('toggle-sidebar');
  toggleBtn.addEventListener('click', () => sidebar.classList.toggle('visible'));

  // ===== Back to top =====
  const backTop = document.getElementById('back-top');
  window.addEventListener('scroll', () => {
    backTop.classList.toggle('show', window.scrollY > 400);
  });
  backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // ===== Active nav =====
  const navLinks = document.querySelectorAll('.nav-link');
  const sections = document.querySelectorAll('section[id]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id);
        });
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => observer.observe(s));

  // ===== Search =====
  const search = document.getElementById('search');
  function applySearch() {
    const q = search.value.toLowerCase().trim();
    const activeCats = new Set();
    document.querySelectorAll('.filter-check:checked').forEach(cb => activeCats.add(cb.dataset.cat));
    navLinks.forEach(link => {
      const matchText = !q || link.textContent.toLowerCase().includes(q);
      const matchCat = activeCats.has(link.dataset.cat);
      link.classList.toggle('hidden', !(matchText && matchCat));
    });
    sections.forEach(sec => {
      const matchText = !q || sec.textContent.toLowerCase().includes(q);
      const matchCat = activeCats.has(sec.dataset.cat);
      sec.classList.toggle('hidden-filtered', !(matchText && matchCat));
    });
  }
  search.addEventListener('input', applySearch);

  // ===== Filter =====
  const filterToggle = document.getElementById('filter-toggle');
  const filterPanel = document.getElementById('filter-panel');
  filterToggle.addEventListener('click', () => filterPanel.classList.toggle('open'));
  document.querySelectorAll('.filter-check').forEach(cb => cb.addEventListener('change', applySearch));

  // ===== Smooth scroll =====
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (window.innerWidth <= 1024) sidebar.classList.remove('visible');
          history.pushState(null, '', href);
        }
      }
    });
  });

  // ===== Ctrl+K =====
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); search.focus(); }
  });

  // ===== Charts =====
  const chartInstances = [];
  function getChartColors() {
    const isDark = htmlEl.getAttribute('data-theme') === 'dark';
    return { text: isDark ? '#e2e8f0' : '#1e293b', grid: isDark ? '#334155' : '#e2e8f0' };
  }
  function createPhaseChart() {
    const ctx = document.getElementById('chartPhaseCost');
    if (!ctx) return;
    const c = getChartColors();
    chartInstances.push(new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Fasa 0–1', 'Fasa 2–3', 'Fasa 4–5'],
        datasets: [
          { label: 'Storan', data: [150, 400, 900], backgroundColor: '#0ea5e9' },
          { label: 'Pengiraan', data: [800, 2000, 4500], backgroundColor: '#8b5cf6' },
          { label: 'Orkestrasi', data: [350, 500, 800], backgroundColor: '#10b981' },
          { label: 'Query', data: [200, 600, 1500], backgroundColor: '#f59e0b' },
          { label: 'Lain-lain', data: [450, 1150, 2750], backgroundColor: '#64748b' }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false,
        plugins: { title: { display: true, text: 'Kos Bulanan (€)', color: c.text }, legend: { labels: { color: c.text, font: { size: 10 } } } },
        scales: { x: { stacked: true, ticks: { color: c.text }, grid: { color: c.grid } }, y: { stacked: true, ticks: { color: c.text }, grid: { color: c.grid } } }
      }
    }));
  }
  function createBreakdownChart() {
    const ctx = document.getElementById('chartCostBreakdown');
    if (!ctx) return;
    const c = getChartColors();
    chartInstances.push(new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Pengiraan', 'Storan', 'Query', 'Orkestrasi', 'Lain-lain'],
        datasets: [{ data: [7300, 1450, 2300, 1650, 2950],
          backgroundColor: ['#8b5cf6', '#0ea5e9', '#f59e0b', '#10b981', '#64748b'] }]
      },
      options: { responsive: true, maintainAspectRatio: false,
        plugins: { title: { display: true, text: 'Pecahan Kos (Fasa 4–5)', color: c.text }, legend: { position: 'right', labels: { color: c.text, font: { size: 10 } } } }
      }
    }));
  }
  function create12MonthChart() {
    const ctx = document.getElementById('chart12Months');
    if (!ctx) return;
    const c = getChartColors();
    chartInstances.push(new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['B1','B2','B3','B4','B5','B6','B7','B8','B9','B10','B11','B12'],
        datasets: [
          { label: 'Kos Sebenar', data: [1200,1500,1800,2500,3200,4000,4650,5500,6800,8000,9500,10450],
            borderColor: '#0ea5e9', backgroundColor: 'rgba(14,165,233,0.1)', tension: 0.3, fill: true },
          { label: 'Bajet', data: [2000,2000,2500,3000,4000,4500,5000,6000,7000,8500,10000,11000],
