      md += `## ${h2.textContent.replace(/^\d+\s*/, '')}\n\n`;
      const paras = sec.querySelectorAll('p, li, h3');
      paras.forEach(el => {
        if (el.tagName === 'H3') md += `### ${el.textContent}\n\n`;
        else if (el.tagName === 'P') md += `${el.textContent}\n\n`;
        else if (el.tagName === 'LI') md += `- ${el.textContent}\n`;
      });
      md += '\n';
    });
    return md;
  }
