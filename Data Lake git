function buildMockURL(path) {
  const handler = MockData[path];
  if (!handler) throw new Error('Unknown endpoint: ' + path);
  const json = JSON.stringify(handler(), null, 2);
  return 'data:application/json;charset=utf-8,' + encodeURIComponent(json);
}

async function tryAPI(path) {
  const req = document.getElementById('api-request');
  const res = document.getElementById('api-response');
  const url = buildMockURL(path);
  req.textContent = `GET ${path}\nHost: sgae-data-lake.local\nAccept: application/json\n\n→ Fetching...`;
  try {
    const r = await fetch(url);
    const data = await r.json();
    req.textContent = `GET ${path}\nHost: sgae-data-lake.local\nAccept: application/json\n\n← 200 OK (${JSON.stringify(data).length} bytes)`;
    res.textContent = JSON.stringify(data, null, 2);
  } catch (err) {
    res.textContent = 'Error: ' + err.message;
  }
}

