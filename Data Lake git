/* ===================== EDITOR ===================== */
let editorInstance = null;
const EDITOR_STORAGE_KEY = 'sgae-editor-';

function getEditorDefaults(file) {
  return PROJECT_FILES[file] || '# Fail tidak tersedia dalam ZIP\n';
}

function initEditor() {
  const ta = document.getElementById('editor-textarea');
  const sel = document.getElementById('editor-file-select');
  if (!ta || !sel) return;

  const saved = localStorage.getItem(EDITOR_STORAGE_KEY + sel.value);
  ta.value = saved || getEditorDefaults(sel.value);

  if (typeof CodeMirror !== 'undefined') {
    editorInstance = CodeMirror.fromTextArea(ta, {
      lineNumbers: true,
      mode: getModeForFile(sel.value),
      theme: 'material-darker',
      autoCloseBrackets: true,
      matchBrackets: true,
      styleActiveLine: true,
      lineWrapping: true
    });
    editorInstance.on('change', () => {
      clearTimeout(editorInstance._saveTimer);
      editorInstance._saveTimer = setTimeout(autoSaveEditor, 3000);
    });
  }

  sel.addEventListener('change', () => {
    const file = sel.value;
    const savedContent = localStorage.getItem(EDITOR_STORAGE_KEY + file);
    setEditorContent(savedContent || getEditorDefaults(file));
    if (editorInstance) {
      editorInstance.setOption('mode', getModeForFile(file));
    }
    updateEditorStatus('Dimuatkan: ' + file);
  });

  // Auto-save
  setInterval(autoSaveEditor, 3000);
}

function getModeForFile(file) {
  if (file.endsWith('.yml') || file.endsWith('.yaml')) return 'yaml';
  if (file.endsWith('.csv')) return null;
  if (file.endsWith('.py')) return 'python';
  if (file.endsWith('.sql')) return 'sql';
  if (file.endsWith('.json')) return { name: 'javascript', json: true };
  if (file.endsWith('.md')) return 'markdown';
  if (file.endsWith('.properties')) return null;
  return null;
}

function getEditorContent() {
  if (editorInstance) return editorInstance.getValue();
  return document.getElementById('editor-textarea').value;
}

function setEditorContent(content) {
  if (editorInstance) {
    editorInstance.setValue(content);
  } else {
    document.getElementById('editor-textarea').value = content;
  }
}

function autoSaveEditor() {
  const sel = document.getElementById('editor-file-select');
  if (!sel) return;
  const content = getEditorContent();
  localStorage.setItem(EDITOR_STORAGE_KEY + sel.value, content);
}

function saveEditor() {
  const sel = document.getElementById('editor-file-select');
  const content = getEditorContent();
  localStorage.setItem(EDITOR_STORAGE_KEY + sel.value, content);
  updateEditorStatus('✅ Disimpan: ' + new Date().toLocaleTimeString('ms-MY'));
}

function resetEditor() {
  const sel = document.getElementById('editor-file-select');
  if (!confirm('Reset ke versi asal? Perubahan tempatan akan hilang.')) return;
  localStorage.removeItem(EDITOR_STORAGE_KEY + sel.value);
  setEditorContent(getEditorDefaults(sel.value));
  updateEditorStatus('🔄 Direset');
}

function downloadEditor() {
  const sel = document.getElementById('editor-file-select');
  const content = getEditorContent();
  const filename = sel.value.split('/').pop();
  downloadBlob(content, filename, 'text/plain');
}

function updateEditorStatus(msg) {
  const el = document.getElementById('editor-status');
  if (el) el.textContent = msg;
}

// Init editor when section visible
const editorSec = document.getElementById('editor');
if (editorSec) {
  new IntersectionObserver((entries, obs) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        if (!editorInstance) initEditor();
        obs.disconnect();
      }
    });
  }, { threshold: 0.1 }).observe(editorSec);
}

